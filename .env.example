# Optional custom directory for local login state (defaults to ~/.config/wechat-mp-export with 0600 permissions)
# WECHAT_MP_EXPORT_STATE_DIR=

# Optional HTTP/HTTPS proxy for network requests
# WECHAT_MP_EXPORT_PROXY=http://127.0.0.1:7890

# Optional Halo 2.x importer settings (used only by `wechat-mp-export import-halo`)
# HALO_BASE_URL=https://blog.example.com
# HALO_PAT=pat_xxxxxxxxxxxxxxxxxxxxxxxx
# HALO_PASSWORD=
